# Olist multi-agent local model deployment (optional model-assisted mode).
# The scored JSON path is deterministic and does not require a model server.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
INVESTIGATOR_MODEL="qwen2.5:7b"
ADJUDICATOR_MODEL="llama3:8b"
VERIFIER_MODEL="llama3:8b"

# Switch every agent to OpenAI without changing the local Ollama code:
# MODEL_PROVIDER="openai"
# MODEL_MODE="required"
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"

# ─── Preferred for this workshop: Google Gemini ───
GOOGLE_API_KEY="<your-gemini-api-key>"
# GEMINI_API_KEY="<your-gemini-api-key>"   # also accepted (alias)
# GEMINI_MODEL=gemini-2.5-flash            # or gemini-2.5-pro

# ─── Optional alternatives (auto-picked if Gemini key missing) ───
# OPENAI_API_KEY="<openai-api-key>"
# OPENAI_MODEL=openai:gpt-4.1-mini
# OPENAI_BASE_URL="<openai-base-url>"

# ANTHROPIC_API_KEY="<anthropic-api-key>"
# ANTHROPIC_MODEL=anthropic:claude-haiku-4-5

# Optional LangSmith tracing
# LANGSMITH_API_KEY="<langsmith-api-key>"
# LANGSMITH_ENDPOINT="<langsmith-endpoint>"
# LANGSMITH_TRACING="true"
# LANGSMITH_PROJECT="langgraph-101"

# Azure OpenAI
# AZURE_OPENAI_API_KEY="<azure-openai-api-key>"
# AZURE_OPENAI_ENDPOINT="<azure-openai-endpoint>"
# AZURE_OPENAI_API_VERSION=""

# AWS Bedrock
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION_NAME=""
# AWS_MODEL_ARN=""

# Google Vertex AI (service account JSON — different from API key above)
# GOOGLE_APPLICATION_CREDENTIALS="./vertexCred.json"
